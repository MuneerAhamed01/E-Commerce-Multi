# Prod environment - loaded via:
#   fvm flutter run -t lib/main_prod.dart --release --dart-define-from-file=../../config/env/prod.env
#
# Non-secret configuration only - see docs/11_ENVIRONMENT_CONFIGURATION.md §3-4.
# Every key here is read exactly once, inside AppConfig.forEnvironment()
# (packages/core/lib/config/app_config.dart) - never directly from feature code.
#
# NOTE: ENABLE_DEVELOPER_MODE is deliberately NOT set to true here - and even
# if it were, main_prod.dart hardcodes developerModeForcedOff: true as a
# source-level literal, so this file cannot accidentally ship developer
# tooling to production. See docs/11_ENVIRONMENT_CONFIGURATION.md §8.

DATA_SOURCE_MODE=mock
LOG_LEVEL=warning
MOCK_LATENCY_MIN_MS=300
MOCK_LATENCY_MAX_MS=800
DEFAULT_TENANT_ID=default
ENABLE_DEVELOPER_MODE=false
SENTRY_DSN=
